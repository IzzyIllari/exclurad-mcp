          "type": "text",
          "text": "I'll start by understanding the available channels and checking the kinematic point.",
          "time": {
            "start": 1789001669493,
            "end": 1789001670391
          },
          "id": "prt_088cf1b75001Y9Bqv0d8fQpAqf",
