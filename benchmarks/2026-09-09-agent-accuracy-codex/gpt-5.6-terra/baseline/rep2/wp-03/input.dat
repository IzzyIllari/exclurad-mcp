3       ! physics model: 1=AO, 2=MAID98, 3=MAID2007
0       ! correction: 0=full, 1=factorizable and leading-log
1.645   ! incident electron momentum [GeV/c] (template assumption)
0.0     ! target proton momentum [GeV/c]
1       ! lepton: 1=electron, 2=muon
2       ! detected hadron: 1=proton, 2=pi+
0.05    ! inelasticity cut v_cut [GeV]

1       ! number of kinematic points
1.400   ! W [GeV]
0.800   ! Q^2 [GeV^2]
0.300   ! cos(theta*)
120.0   ! phi* [degrees]
